---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}
const { entry, headings = [] } = Astro.props;
const d = entry.data as any;
const { title, description, pubDate, updatedDate, author, categories = [], metaTitle, image } = d;
const fmt = (x: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(x);

/* Voor bestemmingspagina's: de andere pagina's over dezelfde plaats. */
const PREFIXES = ['eten-en-drinken-in-', 'klimaat-in-', 'activiteiten-in-', 'workation-in-', 'emigreren-', 'kaart-', 'veiligheid-in-'];
const LABELS: Record<string, string> = {
  'eten-en-drinken-in-': 'Eten & drinken',
  'klimaat-in-': 'Klimaat',
  'activiteiten-in-': 'Activiteiten',
  'workation-in-': 'Workation',
  'emigreren-': 'Emigreren',
  'kaart-': 'Kaart',
  'veiligheid-in-': 'Veiligheid',
};
let place = '';
let prefix = '';
for (const p of PREFIXES) {
  if (entry.id.startsWith(p)) { place = entry.id.slice(p.length); prefix = p; break; }
}
const isDest = categories.includes('Bestemmingen');
let related: { href: string; label: string }[] = [];
if (isDest && !entry.id.startsWith('wonen-werken-in-')) {
  const all = await getCollection('blog');
  const ids = new Set(all.map((a) => a.id));
  const base = place || entry.id;
  if (prefix && ids.has(base)) related.push({ href: `/${base}/`, label: 'Overzicht' });
  for (const p of PREFIXES) {
    if (p === prefix) continue;
    if (ids.has(p + base)) related.push({ href: `/${p}${base}/`, label: LABELS[p] });
  }
}
const catSlug: Record<string, string> = {
  Bedrijven: 'bedrijven', Blog: 'blog', Crypto: 'crypto', Marketing: 'marketing', Nieuws: 'nieuws',
  Reizen: 'reizen', Spotify: 'spotify', TikTok: 'tiktok', Overig: 'uncategorized', Vervoer: 'vervoer',
};
---
<BaseLayout title={metaTitle || title} description={description} image={image}>
  <div class="progress" id="progress"></div>

  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs">
        <a href="/">Home</a>
        {isDest ? (
          <>
            <span>/</span>
            <a href="/bestemmingen/">Bestemmingen</a>
          </>
        ) : categories[0] && catSlug[categories[0]] ? (
          <>
            <span>/</span>
            <a href={`/category/${catSlug[categories[0]]}/`}>{categories[0]}</a>
          </>
        ) : null}
      </p>
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
  </section>

  <div class="article">
    <div class="wrap article-layout">
      <article>
        {image && (
          <figure class="hero-figure">
            <img src={image} alt="" loading="eager" decoding="async" />
          </figure>
        )}
        <div class="meta-line">
          {categories[0] && <span class="badge">{categories[0]}</span>}
          {author && <span>Door <strong>{author}</strong></span>}
          <span>Gepubliceerd {fmt(pubDate)}</span>
          {updatedDate && <span>Bijgewerkt {fmt(updatedDate)}</span>}
        </div>
        <div class="prose">
          <slot />
        </div>
        {related.length > 0 && (
          <div style="margin-top:44px;padding-top:28px;border-top:1px solid var(--line)">
            <h2 style="font-family:var(--slab);font-size:1.2rem;margin:0 0 14px;color:var(--navy)">
              Meer over {place.replace(/-/g, ' ')}
            </h2>
            <div class="chips">
              {related.map((r) => <a href={r.href}>{r.label}</a>)}
            </div>
          </div>
        )}
      </article>

      <aside class="aside">
        <Toc headings={headings} />
        <div class="box accent">
          <h3>Bestemmingen</h3>
          <p>Bekijk alle steden en landen met praktische info over kosten, visa, klimaat en veiligheid.</p>
          <a class="btn btn-sky" href="/bestemmingen/">Alle bestemmingen</a>
        </div>
        <div class="box">
          <h3>Handig om te lezen</h3>
          <div class="links">
            <a href="/belasting-besparen/">Belasting besparen als nomad</a>
            <a href="/183-2/">De 183-dagenregeling</a>
            <a href="/blog/">Alle artikelen</a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      var bar = document.getElementById('progress');
      var art = document.querySelector('.article');
      if (!bar || !art) return;
      function upd() {
        var top = art.offsetTop;
        var h = art.offsetHeight - window.innerHeight;
        var p = h > 0 ? ((window.scrollY - top) / h) * 100 : 0;
        bar.style.width = Math.max(0, Math.min(100, p)) + '%';
      }
      document.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd);
      upd();
    })();
  </script>
</BaseLayout>
