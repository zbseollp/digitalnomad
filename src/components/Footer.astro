---
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();
const landen = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('wonen-werken-in-'))
  .map((p) => ({
    href: `/${p.id}/`,
    label: p.id.replace('wonen-werken-in-', '').replace(/-/g, ' ').replace(/^\w/, (c) => c.toUpperCase()),
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'nl'));
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <img
          src="/wp-content/uploads/2021/07/digitalnomad-1.svg"
          alt="Digitalnomad.nl"
          style="height:32px;width:auto;margin-bottom:14px"
        />
        <p style="margin:0;max-width:38ch">
          Alles over locatie-onafhankelijk werken: bestemmingen, visa, kosten van levensonderhoud, belastingen en
          praktische tips voor digital nomads.
        </p>
      </div>
      <div>
        <h4>Ontdek</h4>
        <a href="/blog/">Blog</a>
        <a href="/bestemmingen/">Alle bestemmingen</a>
        <a href="/category/reizen/">Reizen</a>
        <a href="/category/nieuws/">Nieuws</a>
        <a href="/category/crypto/">Crypto</a>
      </div>
      <div>
        <h4>Praktisch</h4>
        <a href="/belasting-besparen/">Belasting besparen</a>
        <a href="/183-2/">183 dagen regeling</a>
        <a href="/sitemap/">Sitemap</a>
      </div>
      <div>
        <h4>Over</h4>
        <a href="/over-ons/">Over ons</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy policy</a>
      </div>
    </div>

    {landen.length > 0 && (
      <div class="foot-countries">
        {landen.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    )}

    <div class="foot-bottom">
      <span>&copy; {year} Digitalnomad.nl</span>
      <span>Digital nomad worden? Begin hier.</span>
    </div>
  </div>
</footer>
