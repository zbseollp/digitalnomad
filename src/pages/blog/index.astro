---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/PostGrid.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !(p.data.categories ?? []).includes('Bestemmingen'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const cats = [...new Set(posts.flatMap((p) => p.data.categories ?? []))].sort();
const slugFor: Record<string, string> = {
  Bedrijven: 'bedrijven', Blog: 'blog', Crypto: 'crypto', Marketing: 'marketing', Nieuws: 'nieuws',
  Reizen: 'reizen', Spotify: 'spotify', TikTok: 'tiktok', Overig: 'uncategorized', Vervoer: 'vervoer',
};
---

<BaseLayout
  title="Blog | Digitalnomad.nl"
  description="Alle artikelen van Digitalnomad.nl: nieuws, ervaringen, financiën en praktische tips voor digital nomads."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Blogs</h1>
      <p>{posts.length} artikelen over locatie-onafhankelijk werken, reizen, geld en belastingen. Meest recente eerst.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="chips" style="margin-bottom:30px">
        {cats.filter((c) => slugFor[c]).map((c) => <a href={`/category/${slugFor[c]}/`}>{c}</a>)}
      </div>
      <PostGrid posts={posts} />
    </div>
  </section>
</BaseLayout>
