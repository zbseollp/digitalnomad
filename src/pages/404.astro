---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina niet gevonden | Digitalnomad.nl" noindex={true}>
  <section class="page-hero">
    <div class="wrap">
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>De pagina die je zocht is verplaatst of verwijderd. Hieronder vind je de meest gebruikte pagina's.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="grid grid-3">
        <a class="tile" href="/"><h3>Home</h3><p>Terug naar de homepage.</p></a>
        <a class="tile" href="/blog/"><h3>Blog</h3><p>Alle artikelen voor digital nomads.</p></a>
        <a class="tile" href="/bestemmingen/"><h3>Bestemmingen</h3><p>Alle steden en landen op een rij.</p></a>
        <a class="tile" href="/belasting-besparen/"><h3>Belasting besparen</h3><p>Fiscale uitleg voor nomads.</p></a>
        <a class="tile" href="/sitemap/"><h3>Sitemap</h3><p>Overzicht van de hele site.</p></a>
        <a class="tile" href="/contact/"><h3>Contact</h3><p>Neem contact met ons op.</p></a>
      </div>
    </div>
  </section>
</BaseLayout>
