---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';

const all = await getCollection('blog');
const byDate = (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const posts = all
  .filter((p) => !(p.data.categories ?? []).includes('Bestemmingen'))
  .sort(byDate)
  .slice(0, 6);

const DEST_PREFIXES = [
  'eten-en-drinken-in-', 'klimaat-in-', 'activiteiten-in-', 'workation-in-',
  'emigreren-', 'kaart-', 'veiligheid-in-', 'wonen-werken-in-',
];
const steden = all
  .filter((p) => (p.data.categories ?? []).includes('Bestemmingen') && !DEST_PREFIXES.some((x) => p.id.startsWith(x)))
  .sort((a, b) => a.id.localeCompare(b.id));
const landen = all
  .filter((p) => p.id.startsWith('wonen-werken-in-'))
  .sort((a, b) => a.id.localeCompare(b.id));

const pijlers = [
  { titel: 'Wonen & werken', tekst: 'Digital nomads staan erom bekend overal ter wereld te kunnen wonen en werken. Op Digitalnomad.nl lees je er alles over.', href: '/bestemmingen/', icon: '/wp-content/uploads/2022/03/productivity-1.svg' },
  { titel: 'Tutorials', tekst: 'Handige tips en tricks om jouw leven als digital nomad te vergemakkelijken.', href: '/blog/', icon: '/wp-content/uploads/2022/03/002-opinion.svg' },
  { titel: 'De mooiste reizen', tekst: 'Ontdek de mooiste en meest populaire digital nomad bestemmingen ter wereld.', href: '/category/reizen/', icon: '/wp-content/uploads/2022/03/003-travel-guide.svg' },
  { titel: 'Financiën', tekst: 'Leer hoe je als digital nomad geld verdient en slim omgaat met belasting.', href: '/belasting-besparen/', icon: '/wp-content/uploads/2022/03/001-honeymoon1.svg' },
];
---

<BaseLayout
  title="Digital Nomad Blog Nederland | Informatie & Tips |"
  description="Wil jij graag de wereld rondreizen en tegelijkertijd geld verdienen als digital nomad? Lees verder om er achter te komen hoe dit kan!"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>De grootste digital nomad blog van Nederland</h1>
        <p class="lead">
          Welkom op Digitalnomad.nl. Hier vind je alles over het bestaan van een digital nomad en de tips om dat
          bestaan te vergemakkelijken &mdash; van bestemmingen en visa tot belastingen en geld verdienen onderweg.
        </p>
        <ul class="usp">
          <li>{steden.length} bestemmingen uitgewerkt</li>
          <li>{landen.length} landen met woon- en werkinfo</li>
          <li>Praktische fiscale uitleg</li>
        </ul>
        <p style="margin:0">
          <a class="btn" href="/bestemmingen/">Bekijk bestemmingen</a>
          <a class="btn btn-sky" href="/blog/" style="margin-left:10px">Lees de blog</a>
        </p>
      </div>
      <div>
        <img src="/wp-content/uploads/2021/07/illustration1.png" alt="" loading="eager" style="width:100%;height:auto" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid grid-4">
        {pijlers.map((p) => (
          <a class="card" href={p.href}>
            <img src={p.icon} alt="" width="44" height="44" style="margin-bottom:12px" loading="lazy" />
            <h3>{p.titel}</h3>
            <p>{p.tekst}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <h2 class="section-title">Laatste blogs</h2>
      <p class="section-sub">Nieuws, ervaringen en praktische uitleg voor iedereen die locatie-onafhankelijk werkt.</p>
      <PostGrid posts={posts} />
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/blog/">Alle artikelen</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="section-title">Populaire bestemmingen</h2>
      <p class="section-sub">
        Per stad vind je kosten van levensonderhoud, klimaat, veiligheid, activiteiten en workation-plekken.
      </p>
      <div class="chips">
        {steden.slice(0, 48).map((s) => (
          <a href={`/${s.id}/`}>{s.id.replace(/-/g, ' ')}</a>
        ))}
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/bestemmingen/">Alle {steden.length} bestemmingen</a></p>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <h2 class="section-title">Wonen en werken per land</h2>
      <p class="section-sub">Visum, kosten, belasting en praktische zaken per land op een rij.</p>
      <div class="chips">
        {landen.map((s) => (
          <a href={`/${s.id}/`}>{s.id.replace('wonen-werken-in-', '').replace(/-/g, ' ')}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
